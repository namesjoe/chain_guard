{
  "version": "1.0",
  "blocked_env_vars": [
    "INTERNAL_CORP_TOKEN",
    "ENTERPRISE_API_SECRET",
    "CUSTOM_DB_PASS",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_ACCESS_KEY_ID",
    "AWS_SESSION_TOKEN",
    "GITHUB_TOKEN",
    "GITHUB_PAT",
    "GITLAB_TOKEN",
    "CI_JOB_TOKEN",
    "NPM_TOKEN",
    "PYPI_TOKEN",
    "TWINE_PASSWORD",
    "DOCKER_PASSWORD",
    "VAULT_TOKEN",
    "AZURE_CLIENT_SECRET",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "GOOGLE_API_KEY",
    "AZURE_OPENAI_API_KEY",
    "HF_TOKEN",
    "HUGGINGFACE_TOKEN",
    "COHERE_API_KEY",
    "MISTRAL_API_KEY",
    "GROQ_API_KEY",
    "XAI_API_KEY",
    "REPLICATE_API_TOKEN",
    "STRIPE_API_KEY",
    "STRIPE_SECRET_KEY",
    "SLACK_TOKEN",
    "SLACK_BOT_TOKEN",
    "DISCORD_TOKEN",
    "TELEGRAM_BOT_TOKEN",
    "SENDGRID_API_KEY",
    "TWILIO_AUTH_TOKEN",
    "DATABASE_PASSWORD",
    "DATABASE_URL",
    "PRIVATE_KEY",
    "SECRET_KEY",
    "ENCRYPTION_KEY",
    "JWT_SECRET"
  ],
  "blocked_paths": [
    "/etc/internal_certs",
    "/proc/self/environ",
    "/.vault-token",
    "/.ssh",
    "/.aws",
    "/.kube",
    "/.config/gcloud",
    "/.config/gh",
    "/.github",
    "/.docker/config.json",
    "/.npmrc",
    "/.pypirc",
    "/.netrc",
    "/.git-credentials",
    "/.cargo/credentials",
    "/.terraform.d",
    "/.azure",
    "/.claude",
    "/.codex",
    "/.gemini",
    "/.cursor",
    "/.bash_history",
    "/.zsh_history",
    "/var/run/secrets/kubernetes.io",
    "/.config/google-chrome",
    "/.mozilla/firefox",
    "/Library/Application Support/Google/Chrome",
    "/Library/Safari"
  ]
}
